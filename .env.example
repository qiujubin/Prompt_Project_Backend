# ============================================
# 安全配置 (生产环境必须修改)
# ============================================
# JWT 密钥 - 生产环境必须使用强随机字符串
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-please-change-in-production
# Token 过期时间（分钟），默认 30 天
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# JWT 算法
ALGORITHM=HS256

# ============================================
# 数据库配置 (必须配置)
# ============================================
# PostgreSQL 连接字符串
# 格式: postgresql+psycopg://用户名:密码@主机:端口/数据库名
DB_URL=postgresql+psycopg://postgres:123456@localhost/graduation

# ============================================
# CORS 跨域配置 (必须配置)
# ============================================
# 允许的前端域名，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4133,http://localhost:4133

# ============================================
# ComfyUI 配置 (本地 AI 生成)
# ============================================
# ComfyUI 服务器地址
COMFYUI_HOST=127.0.0.1
# ComfyUI 服务器端口
COMFYUI_PORT=8188
# 协议类型 (http/https)
COMFYUI_PROTOCOL=http
# 连接超时时间（秒）
COMFYUI_CONNECT_TIMEOUT=30
# 请求超时时间（秒）
COMFYUI_REQUEST_TIMEOUT=300
# 最大重试次数
COMFYUI_MAX_RETRY=3
# WebSocket 连接池大小
COMFYUI_POOL_SIZE=5
# HTTP 连接池大小
COMFYUI_HTTP_POOL_SIZE=10

# ============================================
# 外部 AI API 配置 (可选，云端 AI 服务)
# ============================================
# OpenAI 兼容 API 密钥
AI_API_KEY=
# API 地址
AI_API_URL=https://api.openai.com/v1

# ============================================
# DeepSeek 配置 (可选，用于翻译服务)
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# ============================================
# 百度翻译配置 (可选)
# ============================================
BAIDU_TRANS_APPID=
BAIDU_TRANS_KEY=

# ============================================
# 微信登录配置 (可选)
# ============================================
WECHAT_APPID=
WECHAT_SECRET=

# ============================================
# 验证码配置
# ============================================
# 验证码过期时间（秒）
VERIFICATION_CODE_EXPIRE_SECONDS=300
# 最大尝试次数
VERIFICATION_CODE_MAX_ATTEMPTS=5
# 重发间隔（秒）
VERIFICATION_CODE_RESEND_INTERVAL=60

# ============================================
# 腾讯云 COS 配置 (图片存储)
# ============================================
# 腾讯云 SecretId
COS_SECRET_ID=your_secret_id_here
# 腾讯云 SecretKey
COS_SECRET_KEY=your_secret_key_here
# COS Bucket 名称 (格式: bucket-appid)
COS_BUCKET=your_bucket_name_here
# COS 区域 (如: ap-guangzhou, ap-beijing, ap-shanghai)
COS_REGION=ap-guangzhou
